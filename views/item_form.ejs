<%- include("partials/header") %>
<section class="form-card">
  <p class="eyebrow">Inventory item</p><h1><%= title %></h1>
  <form method="POST" action="">
    <div><label for="name">Item name</label><input type="text" id="name" name="name" required value="<%= item ? item.name : '' %>" /></div>
    <div><label for="description">Description</label><textarea id="description" name="description" placeholder="Add a helpful description"><%= item ? item.description || '' : '' %></textarea></div>
    <div><label for="price">Price ($)</label><input type="number" step="0.01" min="0" id="price" name="price" required value="<%= item ? item.price : '' %>" /></div>
    <div><label for="number_in_stock">Number in stock</label><input type="number" min="0" id="number_in_stock" name="number_in_stock" required value="<%= item ? item.number_in_stock : '' %>" /></div>
    <div><label for="category_id">Category</label><select id="category_id" name="category_id" required><option value="">Select a category</option><% categories.forEach(category => { %><option value="<%= category.id %>" <%= item && item.category_id === category.id ? 'selected' : '' %>><%= category.name %></option><% }) %></select></div>
    <div class="form-actions"><button type="submit">Save item</button><a class="button secondary" href="/items">Cancel</a></div>
  </form>
</section>
<%- include("partials/footer") %>
